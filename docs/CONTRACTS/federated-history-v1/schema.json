{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akb:proposal:federated-history-auth:1",
  "title": "Proposed federated history authorization (not an active API)",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/decision"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "source_system",
        "canonical_id",
        "governed_resource_id",
        "source_version",
        "policy_binding_id",
        "policy_version",
        "policy_hash"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "record",
            "query_snapshot"
          ]
        },
        "source_system": {
          "enum": [
            "STRATOS_BUDGET",
            "STRATOS_PROJECTFLOW",
            "STRATOS_ARCHFLOW"
          ]
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "governed_resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "tenant_id",
        "actor_subject_id",
        "read_id",
        "nonce",
        "evidence_manifest_hash",
        "purpose",
        "references"
      ],
      "properties": {
        "schema_version": {
          "const": "akb-federated-history-auth-1"
        },
        "provider": {
          "enum": [
            "budget",
            "projectflow",
            "archflow"
          ]
        },
        "tenant_id": {
          "const": "org_stratos"
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "read_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "purpose": {
          "const": "assistant.history.read"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "tenant_id",
        "actor_subject_id",
        "read_id",
        "nonce",
        "evidence_manifest_hash",
        "decision_id",
        "request_digest",
        "decision",
        "issued_at",
        "expires_at",
        "authorized_references",
        "obligations",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {
          "const": "akb-federated-history-auth-1"
        },
        "provider": {
          "enum": [
            "budget",
            "projectflow",
            "archflow"
          ]
        },
        "tenant_id": {
          "const": "org_stratos"
        },
        "actor_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "read_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "decision": {
          "enum": [
            "ALLOW",
            "DENY",
            "STALE",
            "UNAVAILABLE"
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorized_references": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "obligations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,95}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ALLOW"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "authorized_references": {
                "minItems": 1
              },
              "reason_codes": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "authorized_references": {
                "maxItems": 0
              },
              "obligations": {
                "maxItems": 0
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
