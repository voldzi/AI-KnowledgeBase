{
  "name": "@akl/web",
  "version": "0.1.0",
  "private": true,
  "description": "AKB Platform Web Frontend",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/check-director-copilot-v2-contracts.mjs && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "semantic-registry:sync": "node scripts/sync-ssp-semantic-registry.mjs",
    "semantic-registry:check": "node scripts/sync-ssp-semantic-registry.mjs --check",
    "director-copilot-v2:check": "node scripts/check-director-copilot-v2-contracts.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.1.3",
    "@voldzi/stratos-ui": "file:vendor/stratos-ui/voldzi-stratos-ui-0.5.1.tgz",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "effect": "^3.22.1",
    "jose": "6.2.12",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.8.1 <27"
  }
}
