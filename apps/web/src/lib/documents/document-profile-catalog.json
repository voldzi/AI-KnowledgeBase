      "required": true,
      "nullable": false,
      "label": {
        "cs": "Platnost",
        "en": "Validity"
      },
      "options": [
        {
          "value": "fixed_interval",
          "label": {
            "cs": "Pevné období",
            "en": "Fixed interval"
          }
        },
        {
          "value": "until_superseded",
          "label": {
            "cs": "Do nahrazení",
            "en": "Until superseded"
          }
        },
        {
          "value": "record",
          "label": {
            "cs": "Záznam události",
            "en": "Event record"
          }
        }
      ]
    },
    {
      "name": "effectiveFrom",
      "type": "date",
      "required": true,
      "nullable": true,
      "label": {
        "cs": "Účinnost od",
        "en": "Effective from"
