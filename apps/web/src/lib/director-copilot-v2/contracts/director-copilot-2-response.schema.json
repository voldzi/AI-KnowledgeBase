{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratos.zeleznalady.cz/contracts/director-copilot/v2/director-copilot-2-response.schema.json",
  "title": "STRATOS Director Copilot 2 response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "tool_call_id",
    "status",
    "generated_at",
    "as_of",
    "period",
    "source_system",
    "source_version",
    "methodology",
    "completeness",
    "items",
    "warnings",
    "next_cursor"
  ],
  "properties": {
    "schema_version": { "const": "director-copilot-2" },
    "tool_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,119}$" },
    "tool_call_id": { "type": "string", "pattern": "^call_[a-f0-9]{16,64}$" },
    "status": { "enum": ["complete", "partial", "no_data", "not_authorized"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "period": { "$ref": "#/$defs/responsePeriod" },
    "source_system": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$" },
    "source_version": { "type": "string", "minLength": 1, "maxLength": 300 },
    "methodology": { "$ref": "#/$defs/methodology" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/item" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "next_cursor": { "type": ["string", "null"], "maxLength": 500 }
  },
  "$defs": {
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,119}$"
    },
    "responsePeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "fiscal_year"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "fiscal_year": { "type": "integer", "minimum": 2000, "maximum": 2200 }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "temporal_semantics": { "type": "string", "minLength": 1, "maxLength": 240 },
        "aggregation": { "type": "string", "minLength": 1, "maxLength": 240 },
        "comparison_basis": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dimensions": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "components": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "description"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,79}$" },
              "description": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "description": "candidate_count contains only authorized result candidates and must never reveal inaccessible object counts.",
      "required": [
        "authorized_result_complete",
        "source_coverage",
        "missing_reasons",
        "candidate_count"
      ],
      "properties": {
        "authorized_result_complete": { "type": "boolean" },
        "source_coverage": { "enum": ["complete", "partial", "denied"] },
        "missing_reasons": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Number of authorized result candidates before pagination; never includes denied or inaccessible objects."
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "value_type",
        "unit",
        "currency",
        "period_start",
        "period_end",
        "quality"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,119}$" },
        "value": {
          "oneOf": [
            { "type": "string", "maxLength": 1000 },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "value_type": { "enum": ["text", "number", "currency", "percent", "duration_days", "date", "boolean"] },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "currency": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z]{3}$" },
            { "type": "null" }
          ]
        },
        "period_start": { "type": "string", "format": "date" },
        "period_end": { "type": "string", "format": "date" },
        "quality": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "policyLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "binding_id", "hash", "source_version"],
      "properties": {
        "resource_id": { "type": ["string", "null"], "maxLength": 200 },
        "binding_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "hash": {
          "anyOf": [
            { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_id",
        "version",
        "hash",
        "classification",
        "audience",
        "obligations"
      ],
      "properties": {
        "schema_version": { "const": "stratos-information-policy-2" },
        "binding_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "hash": {
          "anyOf": [
            { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handling_class", "legal_classification", "tlp", "pap"],
          "properties": {
            "handling_class": { "type": "string", "minLength": 1, "maxLength": 80 },
            "legal_classification": { "type": "string", "minLength": 1, "maxLength": 80 },
            "tlp": { "type": ["string", "null"], "maxLength": 80 },
            "pap": { "type": ["string", "null"], "maxLength": 80 }
          }
        },
        "audience": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "obligations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "relation_type", "target_entity_type", "target_canonical_id"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,119}$" },
        "relation_type": { "enum": ["direct", "derived", "informational"] },
        "target_entity_type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$" },
        "target_canonical_id": { "type": "string", "pattern": "^stratos:[a-z][a-z0-9-]*:[A-Za-z0-9._:-]{1,240}$" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "entity_id",
        "canonical_id",
        "source_version",
        "as_of",
        "period",
        "unit",
        "currency",
        "facts",
        "methodology",
        "deep_link",
        "document_context_tags",
        "policy",
        "policy_lineage",
        "links"
      ],
      "properties": {
        "entity_type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,79}$" },
        "entity_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "canonical_id": { "type": "string", "pattern": "^stratos:[a-z][a-z0-9-]*:[A-Za-z0-9._:-]{1,240}$" },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 300 },
        "as_of": { "type": "string", "format": "date-time" },
        "period": { "$ref": "#/$defs/responsePeriod" },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "currency": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z]{3}$" },
            { "type": "null" }
          ]
        },
        "facts": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/fact" }
        },
        "methodology": { "$ref": "#/$defs/methodology" },
        "deep_link": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 1000 },
        "document_context_tags": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "policy": {
          "anyOf": [
            { "$ref": "#/$defs/policy" },
            { "type": "null" }
          ]
        },
        "policy_lineage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/policyLineage" }
        },
        "links": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/link" }
        }
      }
    }
  }
}
