{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratos.zeleznalady.cz/contracts/stratos-domain-catalog/v1/catalog.schema.json",
  "title": "STRATOS Domain Tool Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "owner", "tools", "relationships"],
  "properties": {
    "schema_version": {"const": "stratos-domain-catalog-1"},
    "catalog_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 160},
    "owner": {"const": "STRATOS"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/tool"}
    },
    "relationships": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/relationship"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$",
      "minLength": 1,
      "maxLength": 160
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value_type"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 160},
        "value_type": {
          "enum": ["text", "number", "integer", "boolean", "date", "datetime", "currency", "percent", "duration_days"]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "application",
        "source_system",
        "status",
        "contract_version",
        "access_capability",
        "read_capabilities",
        "scope_types",
        "entity_type",
        "canonical_id_prefix",
        "context_tag_prefix",
        "metrics"
      ],
      "properties": {
        "tool_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+\\.v[1-9][0-9]*$", "maxLength": 160},
        "application": {"enum": ["budget", "projectflow", "archflow", "aiip", "akb"]},
        "source_system": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["connected", "contract_ready"]},
        "contract_version": {"$ref": "#/$defs/identifier"},
        "access_capability": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z][a-z0-9_-]+:[a-z][a-z0-9_-]+$", "maxLength": 160}
          ]
        },
        "read_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "scope_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "entity_type": {"$ref": "#/$defs/identifier"},
        "canonical_id_prefix": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+:$", "maxLength": 160},
        "context_tag_prefix": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+:$", "maxLength": 160},
        "metrics": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/metric"}
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "from_entity_type",
        "to_entity_type",
        "strategy",
        "relation_metric",
        "target_canonical_id_prefix"
      ],
      "properties": {
        "relationship_id": {"$ref": "#/$defs/identifier"},
        "from_entity_type": {"$ref": "#/$defs/identifier"},
        "to_entity_type": {"$ref": "#/$defs/identifier"},
        "strategy": {"enum": ["shared_canonical_id", "context_tag", "declared_relation_fact"]},
        "relation_metric": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 160}
          ]
        },
        "target_canonical_id_prefix": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+:$", "maxLength": 160}
      }
    }
  }
}
