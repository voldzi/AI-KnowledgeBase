{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratos.zeleznalady.cz/contracts/identity-cleanup/v1/akb-identity-owner-confirmation.schema.json",
  "title": "AKB owner confirmation for the STRATOS clean-pilot identity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "epochId",
    "gate",
    "repository",
    "ownerRole",
    "identityManifestRevision",
    "identityManifestSha256",
    "routeBindingContractRevision",
    "routeBindingContractSha256",
    "submissionStatus",
    "authority",
    "productionMutationAuthorized",
    "resetAuthorized",
    "deployAuthorized",
    "unknownIdentityDecision",
    "serviceTokenAudiencePolicy",
    "routeScopePolicy",
    "browserServiceTokenReuse",
    "browserRedirectBinding",
    "entries",
    "routeBindings",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": { "const": "stratos-clean-pilot-akb-identity-owner-confirmation-1" },
    "revision": { "const": "1.0.0" },
    "epochId": { "const": "clean-pilot-epoch-1" },
    "gate": { "const": "C5" },
    "repository": { "const": "AKB/ai-knowledgebase" },
    "ownerRole": { "const": "akb-owner" },
    "identityManifestRevision": { "const": "1.0.0" },
    "identityManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "routeBindingContractRevision": { "const": "1.0.0" },
    "routeBindingContractSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "submissionStatus": { "enum": ["MISSING", "DRAFT", "SUBMITTED"] },
    "authority": { "const": "SOURCE_ONLY" },
    "productionMutationAuthorized": { "const": false },
    "resetAuthorized": { "const": false },
    "deployAuthorized": { "const": false },
    "unknownIdentityDecision": { "const": "STOP" },
    "serviceTokenAudiencePolicy": { "const": "EXACTLY_ONE_PER_TOKEN" },
    "routeScopePolicy": { "const": "EXACT_MATCH_REQUIRED" },
    "browserServiceTokenReuse": { "const": "PROHIBITED" },
    "browserRedirectBinding": { "const": "RUNTIME_EXACT_MATCH_REQUIRED" },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/confirmationEntry" }
    },
    "routeBindings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/routeBindingConfirmation" }
    },
    "reasonCode": {
      "enum": [
        "AKB_OWNER_CONFIRMATION_NOT_SUBMITTED",
        "AKB_OWNER_DECISIONS_PENDING",
        "AKB_OWNER_CONFIRMATION_SUBMITTED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "submissionStatus": { "const": "MISSING" } },
        "required": ["submissionStatus"]
      },
      "then": {
        "properties": {
          "entries": { "type": "array", "maxItems": 0 },
          "routeBindings": { "type": "array", "maxItems": 0 },
          "reasonCode": { "const": "AKB_OWNER_CONFIRMATION_NOT_SUBMITTED" }
        }
      }
    },
    {
      "if": {
        "properties": { "submissionStatus": { "const": "DRAFT" } },
        "required": ["submissionStatus"]
      },
      "then": {
        "properties": {
          "entries": { "type": "array", "minItems": 1 },
          "routeBindings": { "type": "array", "minItems": 1 },
          "reasonCode": { "const": "AKB_OWNER_DECISIONS_PENDING" }
        }
      }
    },
    {
      "if": {
        "properties": { "submissionStatus": { "const": "SUBMITTED" } },
        "required": ["submissionStatus"]
      },
      "then": {
        "properties": {
          "entries": { "type": "array", "minItems": 1 },
          "routeBindings": { "type": "array", "minItems": 1 },
          "reasonCode": { "const": "AKB_OWNER_CONFIRMATION_SUBMITTED" }
        }
      }
    }
  ],
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "ownerDecision": {
      "enum": ["PENDING_OWNER_DECISION", "CONFIRM_AS_DECLARED", "RETIRE"]
    },
    "rationaleCode": {
      "enum": [
        "OWNER_DECISION_REQUIRED",
        "REQUIRED_RUNTIME_DEPENDENCY",
        "NOT_USED_IN_CLEAN_EPOCH"
      ]
    },
    "ownerDecisionBinding": {
      "type": "object",
      "if": {
        "type": "object",
        "properties": { "ownerDecision": { "const": "PENDING_OWNER_DECISION" } },
        "required": ["ownerDecision"]
      },
      "then": {
        "type": "object",
        "properties": { "rationaleCode": { "const": "OWNER_DECISION_REQUIRED" } }
      },
      "else": {
        "type": "object",
        "if": {
          "type": "object",
          "properties": { "ownerDecision": { "const": "RETIRE" } },
          "required": ["ownerDecision"]
        },
        "then": {
          "type": "object",
          "properties": { "rationaleCode": { "const": "NOT_USED_IN_CLEAN_EPOCH" } }
        },
        "else": {
          "type": "object",
          "properties": { "rationaleCode": { "const": "REQUIRED_RUNTIME_DEPENDENCY" } }
        }
      }
    },
    "confirmationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "kind",
        "id",
        "ownerDecision",
        "targetAudiences",
        "allowedScopes",
        "onMismatch",
        "rationaleCode"
      ],
      "properties": {
        "mode": { "enum": ["externalOidc", "managedOidc"] },
        "kind": {
          "enum": [
            "realm_role",
            "browser_client",
            "resource_audience",
            "service_client",
            "service_subject"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9/][A-Za-z0-9._:/-]{0,159}$"
        },
        "ownerDecision": { "$ref": "#/$defs/ownerDecision" },
        "targetAudiences": { "$ref": "#/$defs/stringSet" },
        "allowedScopes": { "$ref": "#/$defs/stringSet" },
        "onMismatch": { "const": "STOP" },
        "rationaleCode": { "$ref": "#/$defs/rationaleCode" }
      },
      "allOf": [{ "$ref": "#/$defs/ownerDecisionBinding" }]
    },
    "routeBindingConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "clientId",
        "requestScope",
        "targetAudience",
        "tokenAudienceCardinality",
        "ownerDecision",
        "onMismatch",
        "rationaleCode"
      ],
      "properties": {
        "mode": { "enum": ["externalOidc", "managedOidc"] },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "requestScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "targetAudience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "tokenAudienceCardinality": { "const": "EXACTLY_ONE" },
        "ownerDecision": { "$ref": "#/$defs/ownerDecision" },
        "onMismatch": { "const": "STOP" },
        "rationaleCode": { "$ref": "#/$defs/rationaleCode" }
      },
      "allOf": [{ "$ref": "#/$defs/ownerDecisionBinding" }]
    }
  }
}
