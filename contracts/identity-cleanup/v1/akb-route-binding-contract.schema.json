{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratos.zeleznalady.cz/contracts/identity-cleanup/v1/akb-route-binding-contract.schema.json",
  "title": "AKB route-bound service token contract for the STRATOS clean-pilot epoch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "epochId",
    "unknownRouteBindingDecision",
    "bindings"
  ],
  "properties": {
    "schemaVersion": { "const": "stratos-clean-pilot-akb-route-binding-1" },
    "revision": { "const": "1.0.0" },
    "epochId": { "const": "clean-pilot-epoch-1" },
    "unknownRouteBindingDecision": { "const": "STOP" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/routeBinding" }
    }
  },
  "$defs": {
    "routeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "clientId",
        "requestScope",
        "targetAudience",
        "tokenAudienceCardinality",
        "onMismatch"
      ],
      "properties": {
        "mode": { "enum": ["externalOidc", "managedOidc"] },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "requestScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "targetAudience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
        },
        "tokenAudienceCardinality": { "const": "EXACTLY_ONE" },
        "onMismatch": { "const": "STOP" }
      }
    }
  }
}
