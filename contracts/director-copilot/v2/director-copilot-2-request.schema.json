{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratos.zeleznalady.cz/contracts/director-copilot/v2/director-copilot-2-request.schema.json",
  "title": "STRATOS Director Copilot 2 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "tool_call_id",
    "plan_id",
    "organization_id",
    "actor",
    "requested_at",
    "requested_scopes",
    "parameters"
  ],
  "properties": {
    "schema_version": { "const": "director-copilot-2" },
    "tool_id": {
      "enum": [
        "budget.organization_financial_summary.v1",
        "budget.project_financial_snapshot.v1",
        "projectflow.portfolio_delivery_overview.v1",
        "archflow.need_portfolio_overview.v1",
        "aiip.idea_portfolio_overview.v1"
      ]
    },
    "tool_call_id": { "type": "string", "pattern": "^call_[a-f0-9]{16,64}$" },
    "plan_id": { "type": "string", "pattern": "^plan_[a-f0-9]{16,64}$" },
    "organization_id": { "const": "org_stratos" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject_id"],
      "properties": {
        "type": { "const": "person" },
        "subject_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "requested_scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/scope" }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "entity_filters", "granularity", "group_by", "scenario", "limit"],
      "properties": {
        "period": { "$ref": "#/$defs/period" },
        "entity_filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "organization_unit_ids": { "$ref": "#/$defs/idList" },
            "budget_scope_ids": { "$ref": "#/$defs/idList" },
            "portfolio_ids": { "$ref": "#/$defs/idList" },
            "project_ids": { "$ref": "#/$defs/idList" },
            "need_ids": { "$ref": "#/$defs/idList" },
            "idea_ids": { "$ref": "#/$defs/idList" }
          }
        },
        "granularity": {
          "enum": ["organization", "organization_unit", "portfolio", "project", "item"]
        },
        "group_by": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "scenario": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["plan", "actual", "forecast", "commitments", "variance"] }
        },
        "as_of": { "type": "string", "format": "date-time" },
        "cursor": { "type": ["string", "null"], "maxLength": 500 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "own",
            "public",
            "organization",
            "organization_unit",
            "budget_scope",
            "portfolio",
            "project",
            "document",
            "recipient_set"
          ]
        },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "period": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "fiscal_year"],
          "properties": {
            "type": { "const": "fiscal_year" },
            "fiscal_year": { "type": "integer", "minimum": 2000, "maximum": 2200 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "start", "end"],
          "properties": {
            "type": { "const": "interval" },
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        }
      ]
    },
    "idList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    }
  }
}
