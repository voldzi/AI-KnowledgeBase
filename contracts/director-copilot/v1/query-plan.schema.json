{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratos.zeleznalady.cz/akb/contracts/director-copilot/v1/query-plan.schema.json",
  "title": "AKB Director Copilot QueryPlan V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "intent", "language", "created_at", "as_of", "projection_hash", "query_state", "nodes", "output", "quality_gates"],
  "properties": {
    "schema_version": { "const": "director-copilot-query-plan-4" },
    "plan_id": { "type": "string", "pattern": "^plan_[a-f0-9]{16,64}$" },
    "intent": {
      "enum": [
        "portfolio_risk_correlation",
        "portfolio_performance_overview",
        "project_portfolio_status",
        "budget_portfolio_status",
        "project_access_overview",
        "archflow_demand_overview",
        "aiip_idea_overview",
        "innovation_delivery_trace"
      ]
    },
    "language": { "enum": ["cs", "en"] },
    "created_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "projection_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "query_state": { "$ref": "conversation-query-state.schema.json" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "tool_id", "source_application", "required_capabilities", "requested_scopes", "parameters", "depends_on", "timeout_ms"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^node_[a-z0-9_]+$" },
          "tool_id": { "enum": ["budget.project_financial_snapshot.v1", "projectflow.project_delivery_snapshot.v1", "archflow.need_portfolio_snapshot.v1", "aiip.idea_portfolio_snapshot.v1", "akb.contract_risk_retrieval.v1"] },
          "source_application": { "enum": ["budget", "projectflow", "archflow", "aiip", "akb"] },
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "budget:read",
                "projectflow:read",
                "archflow:read_own",
                "archflow:read_unit",
                "archflow:read_organization",
                "aiip:read_own",
                "aiip:read_unit",
                "aiip:read_organization",
                "akb:chat"
              ]
            }
          },
          "requested_scopes": { "type": "array", "maxItems": 100, "items": { "$ref": "domain-tool.schema.json#/$defs/scope" } },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["as_of", "project_ids", "portfolio_ids"],
            "properties": {
              "as_of": { "type": "string", "format": "date-time" },
              "project_ids": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": { "type": "string", "maxLength": 180, "pattern": "^[A-Za-z0-9._:/-]+$" }
              },
              "portfolio_ids": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": { "type": "string", "maxLength": 180, "pattern": "^[A-Za-z0-9._:/-]+$" }
              }
            }
          },
          "depends_on": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^node_[a-z0-9_]+$" } },
          "timeout_ms": { "type": "integer", "minimum": 500, "maximum": 30000 }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "four_layer_answer", "artifact_contract_version"],
      "properties": {
        "kind": { "const": "answer" },
        "four_layer_answer": { "type": "boolean" },
        "artifact_contract_version": { "const": "report.v2" }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structured_facts_required", "document_citations_required", "partial_must_be_visible", "no_scope_expansion"],
      "properties": {
        "structured_facts_required": { "const": true },
        "document_citations_required": { "type": "boolean" },
        "partial_must_be_visible": { "const": true },
        "no_scope_expansion": { "const": true }
      }
    }
  }
}
