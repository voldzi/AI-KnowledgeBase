{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratos.zeleznalady.cz/akb/contracts/semantic-registry/v1/snapshot.schema.json",
  "title": "STRATOS Semantic Registry Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "source",
    "concept_count",
    "binding_count",
    "content_sha256",
    "concepts",
    "bindings"
  ],
  "properties": {
    "schema_version": { "const": "stratos-semantic-registry-snapshot-1" },
    "snapshot_id": { "type": "string", "pattern": "^ssp-cz-[a-f0-9]{16}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "endpoint", "documentation", "license", "attribution"],
      "properties": {
        "id": { "const": "ssp-cz" },
        "name": { "type": "string", "maxLength": 200 },
        "endpoint": { "type": "string", "format": "uri" },
        "documentation": { "type": "string", "format": "uri" },
        "license": { "type": "string", "maxLength": 80 },
        "attribution": { "type": "string", "maxLength": 300 }
      }
    },
    "concept_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "binding_count": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "pref_label",
          "alt_labels",
          "definition",
          "broader_uris",
          "related_uris"
        ],
        "properties": {
          "uri": { "type": "string", "format": "uri", "maxLength": 2000 },
          "pref_label": { "type": "string", "minLength": 1, "maxLength": 500 },
          "alt_labels": {
            "type": "array",
            "maxItems": 500,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "definition": {
            "type": ["string", "null"],
            "maxLength": 4000
          },
          "broader_uris": {
            "type": "array",
            "maxItems": 500,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri", "maxLength": 2000 }
          },
          "related_uris": {
            "type": "array",
            "maxItems": 500,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uri", "maxLength": 2000 }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_uri",
          "targets",
          "approved_at",
          "approved_by",
          "note"
        ],
        "properties": {
          "concept_uri": { "type": "string", "format": "uri", "maxLength": 2000 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": { "enum": ["source", "metric"] },
                "id": { "type": "string", "minLength": 1, "maxLength": 100 }
              }
            }
          },
          "approved_at": { "type": "string", "format": "date" },
          "approved_by": { "type": "string", "minLength": 1, "maxLength": 120 },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
